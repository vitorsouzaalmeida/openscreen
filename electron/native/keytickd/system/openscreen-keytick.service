[Unit]
Description=OpenScreen key timing service
Documentation=https://github.com/getopenscreen/openscreen
Requires=openscreen-keytick.socket

[Service]
ExecStart=/usr/lib/openscreen/openscreen-keytickd
User=openscreen-keytick
Group=openscreen-keytick
# The only privilege the service has: reading /dev/input/event*.
SupplementaryGroups=input

# Everything else is taken away.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=char-input r
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
